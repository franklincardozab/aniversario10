<script>
// ===== PETAL RAIN =====
const petalColors = ['#e05070','#d4405e','#f08090','#c03050','#e87090','#b82848'];
const container = document.getElementById('petals-container');

function createPetal() {
  const p = document.createElement('div');
  p.className = 'petal';
  const size = Math.random() * 18 + 10;
  const left = Math.random() * 105 - 2;
  const duration = Math.random() * 8 + 7;
  const delay = Math.random() * 5;
  const color = petalColors[Math.floor(Math.random() * petalColors.length)];
  const rot = Math.random() * 60 - 30;

  p.style.cssText = `
    left:${left}%;
    width:${size}px;
    height:${size * 0.75}px;
    background:${color};
    animation-duration:${duration}s;
    animation-delay:${delay}s;
    transform:rotate(${rot}deg);
    border-radius: ${Math.random()>0.5?'150% 0 150% 0':'0 150% 0 150%'};
    opacity:${Math.random()*0.4+0.5};
  `;
  container.appendChild(p);
  setTimeout(() => p.remove(), (duration + delay + 1) * 1000);
}

// Create petals continuously
function petalLoop() {
  createPetal();
  setTimeout(petalLoop, Math.random() * 350 + 100);
}

// Seed initial petals
for (let i = 0; i < 20; i++) {
  setTimeout(createPetal, Math.random() * 3000);
}
petalLoop();

// ===== SCROLL REVEAL =====
const reveals = document.querySelectorAll('.message-card, .illus-section, #final');

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.15 });

reveals.forEach(el => observer.observe(el));

// ===== SPARKLE ON CLICK =====
document.addEventListener('click', (e) => {
  for (let i = 0; i < 5; i++) {
    const s = document.createElement('div');
    s.className = 'sparkle';
    s.textContent = ['✨','🌸','❤️','🌹','💫'][Math.floor(Math.random()*5)];
    s.style.left = (e.clientX + (Math.random()*40-20)) + 'px';
    s.style.top = (e.clientY + (Math.random()*40-20)) + 'px';
    s.style.animationDuration = (Math.random()*0.6+0.6) + 's';
    document.body.appendChild(s);
    setTimeout(() => s.remove(), 1200);
  }
});
</script>
