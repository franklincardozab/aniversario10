<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Feliz Aniversario ❤️</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Dancing+Script:wght@400;700&family=Lato:wght@300;400&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --rose: #c0394b;
    --rose-light: #e8a0aa;
    --rose-pale: #fdf0f2;
    --gold: #c9a84c;
    --cream: #fff8f0;
    --dark: #2a1a1f;
    --petal1: #e05070;
    --petal2: #d4405e;
    --petal3: #f08090;
    --petal4: #c03050;
  }

  html, body {
    width: 100%; height: 100%;
    overflow-x: hidden;
    background: linear-gradient(160deg, #1a0810 0%, #2d0f1c 40%, #1f0a15 100%);
    font-family: 'Lato', sans-serif;
    color: #fff;
    scroll-behavior: smooth;
  }

  /* ===== PETAL RAIN ===== */
  #petals-container {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .petal {
    position: absolute;
    top: -60px;
    border-radius: 150% 0 150% 0;
    opacity: 0.85;
    animation: petalFall linear infinite;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  @keyframes petalFall {
    0%   { transform: translateY(0) rotate(0deg) translateX(0); opacity: 0.9; }
    25%  { transform: translateY(25vh) rotate(90deg) translateX(30px); }
    50%  { transform: translateY(50vh) rotate(180deg) translateX(-20px); opacity: 0.8; }
    75%  { transform: translateY(75vh) rotate(270deg) translateX(25px); }
    100% { transform: translateY(110vh) rotate(360deg) translateX(-15px); opacity: 0; }
  }

  /* ===== MAIN CONTENT ===== */
  #content {
    position: relative;
    z-index: 10;
    min-height: 100vh;
  }

  /* ===== HERO SECTION ===== */
  #hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
    position: relative;
  }

  .hero-glow {
    position: absolute;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(192,57,75,0.25) 0%, transparent 70%);
    border-radius: 50%;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: pulseGlow 4s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
    50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
  }

  .hero-subtitle {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1rem, 3vw, 1.4rem);
    color: var(--gold);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    opacity: 0;
    animation: fadeUp 1s ease 0.3s forwards;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 10vw, 7rem);
    font-weight: 700;
    line-height: 1.1;
    background: linear-gradient(135deg, #fff 0%, #f9d0d8 40%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0;
    animation: fadeUp 1s ease 0.6s forwards;
    margin-bottom: 0.5rem;
  }

  .hero-name {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(2.2rem, 7vw, 5rem);
    color: var(--rose-light);
    opacity: 0;
    animation: fadeUp 1s ease 0.9s forwards;
    margin-bottom: 2rem;
  }

  .hero-hearts {
    font-size: 2rem;
    opacity: 0;
    animation: fadeUp 1s ease 1.2s forwards;
    letter-spacing: 0.5rem;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Dancing Script', cursive;
    color: rgba(255,255,255,0.5);
    font-size: 1rem;
    animation: bounce 2s ease-in-out infinite, fadeUp 1s ease 2s forwards;
    opacity: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-hint::after {
    content: '↓';
    font-size: 1.5rem;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ===== MESSAGES SECTION ===== */
  #messages {
    padding: 4rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .message-card {
    max-width: 700px;
    width: 100%;
    text-align: center;
    padding: 4rem 2rem;
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 0.9s ease, transform 0.9s ease;
    position: relative;
  }

  .message-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .message-card::before {
    content: '❝';
    font-family: 'Playfair Display', serif;
    font-size: 6rem;
    color: rgba(192,57,75,0.2);
    position: absolute;
    top: 1rem; left: 50%;
    transform: translateX(-50%);
    line-height: 1;
  }

  .message-text {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: clamp(1.2rem, 3.5vw, 1.8rem);
    line-height: 1.7;
    color: rgba(255,255,255,0.92);
    position: relative;
    z-index: 1;
  }

  .message-divider {
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    margin: 2rem auto;
  }

  /* ===== ILLUSTRATION SECTIONS ===== */
  .illus-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    text-align: center;
    position: relative;
    opacity: 0;
    transform: translateY(80px);
    transition: opacity 1s ease, transform 1s ease;
  }

  .illus-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .illus-label {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1.6rem, 5vw, 2.8rem);
    color: var(--rose-light);
    margin-bottom: 0.5rem;
    text-shadow: 0 0 30px rgba(192,57,75,0.5);
  }

  .illus-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: rgba(255,255,255,0.6);
    font-style: italic;
    margin-bottom: 3rem;
  }

  /* SVG Container */
  .svg-wrap {
    width: min(340px, 90vw);
    height: min(340px, 90vw);
    position: relative;
    filter: drop-shadow(0 0 30px rgba(192,57,75,0.4));
  }

  /* ===== BEAR SVG ===== */
  .bear-body { animation: bearBob 3s ease-in-out infinite; transform-origin: bottom center; }
  @keyframes bearBob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    25% { transform: translateY(-8px) rotate(-2deg); }
    75% { transform: translateY(-4px) rotate(2deg); }
  }
  .bear-ear-l { animation: earWiggle 2s ease-in-out infinite; transform-origin: bottom center; }
  .bear-ear-r { animation: earWiggle 2s ease-in-out infinite 0.3s; transform-origin: bottom center; }
  @keyframes earWiggle {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(10deg); }
  }
  .bear-eye { animation: blink 4s ease-in-out infinite; }
  @keyframes blink {
    0%, 90%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  .bear-heart { animation: heartPulse 1.2s ease-in-out infinite; transform-origin: center; }
  @keyframes heartPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.25); }
  }

  /* ===== PLANE SVG ===== */
  .plane-group { animation: planeFly 4s ease-in-out infinite; }
  @keyframes planeFly {
    0%   { transform: translate(0px, 0px) rotate(0deg); }
    25%  { transform: translate(20px, -15px) rotate(3deg); }
    50%  { transform: translate(0px, -5px) rotate(0deg); }
    75%  { transform: translate(-20px, -15px) rotate(-3deg); }
    100% { transform: translate(0px, 0px) rotate(0deg); }
  }
  .plane-trail { animation: trailFade 1.5s ease-in-out infinite; }
  @keyframes trailFade {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 0.2; }
  }
  .cloud { animation: cloudDrift linear infinite; }
  .cloud1 { animation-duration: 8s; }
  .cloud2 { animation-duration: 12s; animation-delay: -4s; }
  @keyframes cloudDrift {
    0% { transform: translateX(-80px); opacity: 0; }
    10% { opacity: 0.6; }
    90% { opacity: 0.6; }
    100% { transform: translateX(80px); opacity: 0; }
  }

  /* ===== SERENATA SVG ===== */
  .musician { animation: musicBob 1.5s ease-in-out infinite; transform-origin: bottom center; }
  .musician2 { animation: musicBob 1.5s ease-in-out infinite 0.4s; transform-origin: bottom center; }
  @keyframes musicBob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-6px) rotate(-3deg); }
  }
  .note { animation: noteFloat linear infinite; }
  .note1 { animation-duration: 2.5s; }
  .note2 { animation-duration: 3s; animation-delay: 0.8s; }
  .note3 { animation-duration: 2s; animation-delay: 1.5s; }
  @keyframes noteFloat {
    0% { transform: translate(0,0) rotate(0deg); opacity: 1; }
    100% { transform: translate(20px,-70px) rotate(20deg); opacity: 0; }
  }
  .window-light { animation: flicker 3s ease-in-out infinite; }
  @keyframes flicker {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.5; }
  }
  .window-girl { animation: girlPeek 4s ease-in-out infinite; transform-origin: bottom center; }
  @keyframes girlPeek {
    0%, 40%, 100% { transform: translateY(0); }
    20% { transform: translateY(-8px); }
  }

  /* ===== RESTAURANT SVG ===== */
  .rest-building { animation: restGlow 3s ease-in-out infinite; }
  @keyframes restGlow {
    0%, 100% { filter: drop-shadow(0 0 8px rgba(201,168,76,0.3)); }
    50% { filter: drop-shadow(0 0 20px rgba(201,168,76,0.7)); }
  }
  .star-spin { animation: starPop 1.5s ease-in-out infinite; transform-origin: center; }
  .star-spin:nth-child(1) { animation-delay: 0s; }
  .star-spin:nth-child(2) { animation-delay: 0.3s; }
  .star-spin:nth-child(3) { animation-delay: 0.6s; }
  .star-spin:nth-child(4) { animation-delay: 0.9s; }
  .star-spin:nth-child(5) { animation-delay: 1.2s; }
  @keyframes starPop {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.2) rotate(10deg); }
  }
  .candle-flame { animation: candleFlicker 0.8s ease-in-out infinite alternate; transform-origin: bottom center; }
  @keyframes candleFlicker {
    0% { transform: scaleY(1) scaleX(1) rotate(-3deg); opacity: 0.9; }
    100% { transform: scaleY(1.2) scaleX(0.8) rotate(3deg); opacity: 1; }
  }

  /* ===== FINAL MESSAGE ===== */
  #final {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
    position: relative;
    opacity: 0;
    transition: opacity 1.5s ease;
  }

  #final.visible { opacity: 1; }

  .final-decor {
    font-size: 3rem;
    margin-bottom: 2rem;
    animation: heartPulse 1.2s ease-in-out infinite;
  }

  .final-pero {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1rem, 3vw, 1.4rem);
    color: var(--gold);
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    opacity: 0;
    transition: opacity 1s ease 0.5s;
  }
  #final.visible .final-pero { opacity: 1; }

  .final-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 7vw, 4.5rem);
    font-weight: 700;
    background: linear-gradient(135deg, #fff 0%, #f9d0d8 50%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s ease 0.8s, transform 1s ease 0.8s;
  }
  #final.visible .final-title { opacity: 1; transform: translateY(0); }

  .final-sub {
    font-family: 'Lato', sans-serif;
    font-weight: 300;
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    color: rgba(255,255,255,0.8);
    max-width: 550px;
    line-height: 1.8;
    margin-bottom: 3rem;
    opacity: 0;
    transition: opacity 1s ease 1.1s;
  }
  #final.visible .final-sub { opacity: 1; }

  .final-signature {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--rose-light);
    opacity: 0;
    transition: opacity 1s ease 1.4s;
  }
  #final.visible .final-signature { opacity: 1; }

  /* ===== UTILS ===== */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .section-sep {
    width: 120px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(192,57,75,0.6), transparent);
    margin: 0 auto;
  }

  /* Sparkles */
  .sparkle {
    position: fixed;
    pointer-events: none;
    z-index: 5;
    font-size: 1rem;
    animation: sparkleFade linear forwards;
  }
  @keyframes sparkleFade {
    0% { opacity: 1; transform: scale(0.5) translateY(0); }
    100% { opacity: 0; transform: scale(1.5) translateY(-40px); }
  }
</style>
</head>
<body>

<!-- PETAL RAIN -->
<div id="petals-container"></div>

<div id="content">

  <!-- HERO -->
  <section id="hero">
    <div class="hero-glow"></div>
    <p class="hero-subtitle">Con todo mi amor</p>
    <h1 class="hero-title">Feliz</h1>
    <h1 class="hero-title" style="animation-delay:0.75s">Aniversario</h1>
    <p class="hero-name">gordita 🌹</p>
    <div class="hero-hearts">❤️ 🌸 ❤️</div>
    <div class="scroll-hint">Sigue bajando</div>
  </section>

  <!-- MESSAGES -->
  <section id="messages">

    <div class="message-card">
      <p class="message-text">Cada día a tu lado es un regalo que no merezco pero atesoro con toda el alma...</p>
      <div class="message-divider"></div>
    </div>

    <div class="message-card">
      <p class="message-text">Desde que llegaste, hasta los días grises se volvieron mi color favorito.</p>
      <div class="message-divider"></div>
    </div>

    <div class="message-card">
      <p class="message-text">No hay palabras suficientes para decirte cuánto significas para mí. Pero lo intento cada día.</p>
      <div class="message-divider"></div>
    </div>

  </section>

  <!-- ILLUSTRATION 1: OSO -->
  <section class="illus-section" id="sec-bear">
    <p class="illus-label">No es un oso de peluche...</p>
    <p class="illus-title">es todo el amor que cabe en mis brazos</p>
    <div class="svg-wrap">
      <svg viewBox="0 0 340 340" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <radialGradient id="bearBg" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#3d0f1f"/>
            <stop offset="100%" stop-color="#1a0810"/>
          </radialGradient>
          <radialGradient id="bearBody" cx="45%" cy="40%" r="60%">
            <stop offset="0%" stop-color="#f5c5a8"/>
            <stop offset="100%" stop-color="#e8956a"/>
          </radialGradient>
          <radialGradient id="bearFace" cx="45%" cy="40%" r="60%">
            <stop offset="0%" stop-color="#fad5b8"/>
            <stop offset="100%" stop-color="#f0aa78"/>
          </radialGradient>
          <radialGradient id="tummy" cx="50%" cy="40%" r="55%">
            <stop offset="0%" stop-color="#fde8d0"/>
            <stop offset="100%" stop-color="#f5c8a0"/>
          </radialGradient>
        </defs>
        <!-- glow -->
        <circle cx="170" cy="170" r="130" fill="url(#bearBg)" opacity="0.6"/>
        <g class="bear-body">
          <!-- ears -->
          <circle class="bear-ear-l" cx="110" cy="105" r="30" fill="url(#bearBody)"/>
          <circle cx="110" cy="105" r="18" fill="#f0aa78"/>
          <circle class="bear-ear-r" cx="230" cy="105" r="30" fill="url(#bearBody)"/>
          <circle cx="230" cy="105" r="18" fill="#f0aa78"/>
          <!-- body -->
          <ellipse cx="170" cy="230" rx="72" ry="68" fill="url(#bearBody)"/>
          <!-- tummy -->
          <ellipse cx="170" cy="235" rx="42" ry="46" fill="url(#tummy)"/>
          <!-- legs -->
          <ellipse cx="135" cy="290" rx="28" ry="18" fill="#e8956a"/>
          <ellipse cx="205" cy="290" rx="28" ry="18" fill="#e8956a"/>
          <!-- arms -->
          <ellipse cx="98" cy="245" rx="20" ry="36" fill="#e8956a" transform="rotate(-20,98,245)"/>
          <ellipse cx="242" cy="245" rx="20" ry="36" fill="#e8956a" transform="rotate(20,242,245)"/>
          <!-- head -->
          <ellipse cx="170" cy="155" rx="68" ry="65" fill="url(#bearFace)"/>
          <!-- muzzle -->
          <ellipse cx="170" cy="172" rx="30" ry="22" fill="#fde8d0"/>
          <!-- nose -->
          <ellipse cx="170" cy="162" rx="10" ry="7" fill="#c0705a"/>
          <!-- nostrils -->
          <circle cx="166" cy="163" r="2.5" fill="#9a5040"/>
          <circle cx="174" cy="163" r="2.5" fill="#9a5040"/>
          <!-- smile -->
          <path d="M158,178 Q170,190 182,178" stroke="#9a5040" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <!-- cheeks -->
          <circle cx="140" cy="170" r="14" fill="rgba(230,100,100,0.25)"/>
          <circle cx="200" cy="170" r="14" fill="rgba(230,100,100,0.25)"/>
          <!-- eyes -->
          <g class="bear-eye" style="transform-origin:148px 148px">
            <ellipse cx="148" cy="148" rx="9" ry="10" fill="#2a1a1f"/>
            <circle cx="151" cy="145" r="3" fill="white"/>
          </g>
          <g class="bear-eye" style="transform-origin:192px 148px">
            <ellipse cx="192" cy="148" rx="9" ry="10" fill="#2a1a1f"/>
            <circle cx="195" cy="145" r="3" fill="white"/>
          </g>
          <!-- paws detail -->
          <g opacity="0.6">
            <circle cx="122" cy="270" r="5" fill="#d08060"/>
            <circle cx="112" cy="275" r="5" fill="#d08060"/>
            <circle cx="215" cy="270" r="5" fill="#d08060"/>
            <circle cx="225" cy="275" r="5" fill="#d08060"/>
          </g>
          <!-- heart -->
          <g class="bear-heart">
            <path d="M170,210 C170,210 160,200 155,205 C150,210 150,218 170,230 C190,218 190,210 185,205 C180,200 170,210 170,210 Z" fill="#e8405a" opacity="0.9"/>
          </g>
        </g>
      </svg>
    </div>
  </section>

  <div class="section-sep" style="margin:2rem auto;"></div>

  <!-- ILLUSTRATION 2: AVIÓN -->
  <section class="illus-section" id="sec-plane">
    <p class="illus-label">No es un viaje...</p>
    <p class="illus-title">es la aventura más bonita: la de estar contigo</p>
    <div class="svg-wrap">
      <svg viewBox="0 0 340 340" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <radialGradient id="skyBg" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#0f1a3d"/>
            <stop offset="100%" stop-color="#1a0810"/>
          </radialGradient>
          <linearGradient id="planeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff"/>
            <stop offset="100%" stop-color="#ddeeff"/>
          </linearGradient>
        </defs>
        <!-- sky -->
        <circle cx="170" cy="170" r="150" fill="url(#skyBg)" opacity="0.8"/>
        <!-- stars -->
        <circle cx="60" cy="60" r="2" fill="white" opacity="0.6"/>
        <circle cx="270" cy="80" r="1.5" fill="white" opacity="0.5"/>
        <circle cx="290" cy="140" r="2" fill="white" opacity="0.7"/>
        <circle cx="50" cy="200" r="1.5" fill="white" opacity="0.4"/>
        <circle cx="300" cy="260" r="2" fill="white" opacity="0.6"/>
        <circle cx="80" cy="290" r="1.5" fill="white" opacity="0.5"/>
        <!-- clouds -->
        <g class="cloud cloud1" opacity="0.5">
          <ellipse cx="60" cy="120" rx="35" ry="18" fill="white"/>
          <ellipse cx="80" cy="110" rx="22" ry="16" fill="white"/>
          <ellipse cx="40" cy="115" rx="18" ry="13" fill="white"/>
        </g>
        <g class="cloud cloud2" opacity="0.4">
          <ellipse cx="280" cy="220" rx="30" ry="15" fill="white"/>
          <ellipse cx="295" cy="212" rx="18" ry="13" fill="white"/>
          <ellipse cx="265" cy="215" rx="16" ry="11" fill="white"/>
        </g>
        <!-- trail -->
        <g class="plane-trail">
          <line x1="60" y1="190" x2="155" y2="165" stroke="rgba(255,255,255,0.4)" stroke-width="2.5" stroke-dasharray="8,5"/>
        </g>
        <!-- plane group -->
        <g class="plane-group" style="transform-origin:170px 170px">
          <!-- fuselage -->
          <ellipse cx="185" cy="165" rx="55" ry="18" fill="url(#planeGrad)" transform="rotate(-15,185,165)"/>
          <!-- nose -->
          <path d="M225,145 Q248,158 225,172 Z" fill="#c0d8f0" transform="rotate(-15,225,158)"/>
